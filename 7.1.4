# 07.1.4 Local maxima. Read a sequence of integers that ends with a blank line. Print the position of 
# the local maximum (numbers greater than both the previous and the next value) if there are any; 
# otherwise, print the message 'There are no local maximums'.  
# Extension: If multiple pairs of local maxima exist, locate the two closest local maxima and print their 
# position. 


def find_maximum(numbers):
    maxima = []

    for i in range(1, len(numbers) - 1):
        if numbers[i] > numbers[i-1] and numbers[i] > numbers[i+1]:
            maxima.append(i)

    if maxima:
        print("Local maximum positions:", maxima)
    else:
        print("There are no local maximums.")

    return maxima

def main():
    numbers = []
    while True:        
        user_input = str(input("input a sequence of integers (can be multiple or single. enter blank to end input): "))

        if user_input == "":
            break

        for value in user_input.split():
            numbers.append(int(value))
    
    if not numbers:
        print("No numbers entered.")
        return

    find_maximum(numbers)

main()