#loops practice 1

initial_value = 10000
year = 0
print(f"year: {year}, value: {initial_value} Dollars!")
while initial_value < 20000:
    initial_value = initial_value + (initial_value * 0.05)
    year = year + 1
    print(f"year: {year}, value: {initial_value:,.2f} Dollars!")

print(f"the value has reached over 20000 dollars after {year} years!")






