# loops practice 3

count = 0
total = 0.0

salary = 0.0
power = True
while salary >= 0 and power:
    salary = float(input("Enter a salary or type -1 to exit and calculate:"))
    if salary==-1:
        power = False
        print("program loop has been exited.")
    else:
        total = total + salary
        count += 1
    
    
if count > 0:
    average = total/count
    print(f"The average salary was ${average:,.2f} and over {count} periods")
else:
    print("no data was entered.")
